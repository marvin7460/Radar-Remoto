# Copy to .env.local (never committed) and fill in.

# Turso database URL. Create one at https://turso.tech, then:
#   turso db show radar-remoto --url
# Leave unset locally to use a SQLite file (file:local.db).
TURSO_DATABASE_URL=

# Turso auth token:
#   turso db tokens create radar-remoto
# Not needed for a local file: database.
TURSO_AUTH_TOKEN=

# Enables the admin area (/admin, labeling tool). 16+ random characters:
#   openssl rand -hex 24
# Leave empty to disable the admin area entirely (it returns 404).
ADMIN_TOKEN=
