# Copy to .env.local (never committed) and fill in.

# Turso database URL. Create one at https://turso.tech, then:
#   turso db show radar-remoto --url
# Leave unset locally to use a SQLite file (file:local.db).
TURSO_DATABASE_URL=

# Turso auth token:
#   turso db tokens create radar-remoto
# Not needed for a local file: database.
TURSO_AUTH_TOKEN=

# Enables the admin area (/admin, labeling tool). 16+ random characters:
#   openssl rand -hex 24
# Leave empty to disable the admin area entirely (it returns 404).
ADMIN_TOKEN=

# Signs unsubscribe links. 32+ random characters (openssl rand -hex 32).
AUTH_SECRET=

# Public URL of the app, used in emails (no trailing slash).
APP_URL=http://localhost:3000

# Resend (https://resend.com, free: 100 emails/day). Without a key, emails are
# written to .outbox/ in development instead of being sent.
RESEND_API_KEY=
# Sender; with Resend's test domain you can only email your own address.
EMAIL_FROM=Radar Remoto <onboarding@resend.dev>
